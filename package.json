{
  "name": "gary-jiang-photography",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "optimize-images": "./optimize-images.sh",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "lint:check": "eslint .",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "marked": "^17.0.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.15.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-vue": "^1.1.6",
    "vite": "^6.0.0"
  }
}
